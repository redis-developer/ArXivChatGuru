# This example is for remote Redis usage. The primary local path uses `.env.template`.
OPENAI_API_KEY=ADD_YOUR_KEY_HERE
OPENAI_CHAT_MODEL=gpt-5.4-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
REDIS_INDEX_BASENAME=arxiv
REDIS_URL=rediss://default:YOUR_REDIS_ACCESS_KEY@YOUR_REDIS_INSTANCE.YOUR_REGION.redisenterprise.cache.azure.net:10000
TOKENIZERS_PARALLELISM=false
